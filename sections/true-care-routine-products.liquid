{{ 'true-care-product-sections.css' | asset_url | stylesheet_tag }}

<section id="TrueCareRoutine-{{ section.id }}" class="tc-section tc-routine tc-section__body" dir="rtl" style="--tc-peach: {{ section.settings.background_color }}; --tc-accent: {{ section.settings.accent_color }}; --tc-accent-strong: {{ section.settings.price_color }}; --tc-padding-top: {{ section.settings.padding_top }}px; --tc-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="tc-container">
    <header class="tc-heading"><p class="tc-heading__kicker">{{ section.settings.kicker }}</p><h2>{{ section.settings.heading }}</h2><p class="tc-heading__sub">{{ section.settings.subheading }}</p></header>
    <div class="tc-routine__grid">
      {%- if section.settings.products != blank -%}
        {%- for card_product in section.settings.products limit: 4 -%}
          {%- assign card_variant = card_product.selected_or_first_available_variant -%}
          <article class="tc-routine__card">
            {%- if card_variant.compare_at_price > card_variant.price -%}<span class="tc-routine__discount">{{ section.settings.discount_label }}</span>{%- endif -%}
            <a class="tc-routine__media" href="{{ card_product.url }}">
              {{ card_product.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600, 760', sizes: '(min-width: 768px) 25vw, 47vw', alt: card_product.featured_image.alt, class: 'tc-routine__image tc-routine__image--primary' }}
              {%- if card_product.images[1] != blank -%}
                {{ card_product.images[1] | image_url: width: 760 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600, 760', sizes: '(min-width: 768px) 25vw, 47vw', alt: card_product.images[1].alt, class: 'tc-routine__image tc-routine__image--secondary' }}
              {%- endif -%}
            </a>
            <div class="tc-routine__copy">
              <h3><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
              <div class="tc-routine__prices"><span class="tc-routine__price">{{ card_variant.price | money }}</span>{%- if card_variant.compare_at_price > card_variant.price -%}<s class="tc-routine__compare">{{ card_variant.compare_at_price | money }}</s>{%- endif -%}</div>
              {%- if card_product.available -%}{%- form 'product', card_product -%}<input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button class="tc-routine__button" type="submit">{{ section.settings.button_label }}</button>{%- endform -%}{%- else -%}<button class="tc-routine__button" type="button" disabled>{{ 'products.product.sold_out' | t }}</button>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_assets = 'true-care-routine-brush.jpg,true-care-routine-moisturizer.jpg,true-care-routine-scrub.jpg,true-care-routine-box.jpg' | split: ',' -%}
        {%- assign fallback_titles = 'فرشاة فك تشابك الشعر,مرطب للشعر بزبدة الشيا,سنفرة تنظيف فروة الرأس,بوكس العناية بفروة الشعر' | split: ',' -%}
        {%- for fallback_asset in fallback_assets -%}
          <article class="tc-routine__card"><span class="tc-routine__discount">{{ section.settings.discount_label }}</span><div class="tc-routine__media"><img src="{{ fallback_asset | asset_url }}" width="759" height="738" loading="lazy" alt="{{ fallback_titles[forloop.index0] | escape }}"></div><div class="tc-routine__copy"><h3>{{ fallback_titles[forloop.index0] }}</h3><div class="tc-routine__prices"><span class="tc-routine__price">14.00 KD</span><s class="tc-routine__compare">19.00 KD</s></div><button class="tc-routine__button" type="button" disabled>{{ section.settings.button_label }}</button></div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "True Care routine",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "أكملي روتينك" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "منتجات تكمل العناية" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "كل منتج مصمم ليتكامل مع الآخر" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 },
    { "type": "text", "id": "discount_label", "label": "Discount label", "default": "خصم 30%" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "أضف الى السلة" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffe0c5" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#ff997f" },
    { "type": "color", "id": "price_color", "label": "Price color", "default": "#f44336" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 100, "step": 4, "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 24, "max": 100, "step": 4, "default": 52 }
  ],
  "presets": [{ "name": "True Care routine" }]
}
{% endschema %}
