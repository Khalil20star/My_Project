      "default": "#FDF5EE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#0E0E0E"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Point text",
      "default": "#625D5B"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Subtitle",
      "default": "#9F9896"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#F59F87"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "After accent",
      "default": "#2EC76F"
    },
    {
      "type": "color",
      "id": "danger_color",
      "label": "Before accent",
      "default": "#F59F87"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "before_point",
      "name": "Before point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "after_point",
      "name": "After point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "True Care Before/After",
      "blocks": [
        {
          "type": "after_point",
          "settings": {
            "text": "شعر أنظف وأكثر حيوية"
          }
        },
        {
          "type": "after_point",
          "settings": {
            "text": "فروة راس منتعشة وأنظف"
          }
        },
        {
          "type": "after_point",
          "settings": {
            "text": "نعومة ولمعة واضحة من أول استخدام"
          }
        },
        {
          "type": "after_point",
          "settings": {
            "text": "تراكمات أقل وشعر أكثر حيوية"
          }
        },
        {
          "type": "before_point",
          "settings": {
            "text": "شعر باهت وثقيل"
          }
        },
        {
          "type": "before_point",
          "settings": {
            "text": "تشابك وصعوبة بالتمشيط"
          }
        },
        {
          "type": "before_point",
          "settings": {
            "text": "فروة تحتاج تنظيف وتوازن"
          }
        },
        {
          "type": "before_point",
          "settings": {
            "text": "تراكمات زيوت وبقايا منتجات"
          }
        }
      ]
    }
  ]
}
