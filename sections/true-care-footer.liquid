{{ 'true-care-product-sections.css' | asset_url | stylesheet_tag }}

<footer id="TrueCareFooter-{{ section.id }}" class="tc-section tc-footer" dir="rtl" style="--tc-peach: {{ section.settings.background_color }};">
  <div class="tc-container">
    <div class="tc-footer__grid">
      <div class="tc-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', widths: '146, 292, 320', sizes: '146px', alt: shop.name }}
        {%- else -%}
          <img src="{{ 'true-care-logo.png' | asset_url }}" width="292" height="166" loading="lazy" alt="{{ shop.name | default: 'True Care' | escape }}">
        {%- endif -%}
        <p>{{ section.settings.description }}</p>
        <div class="tc-footer__contact">
          {%- if section.settings.phone != blank -%}
            <a href="tel:{{ section.settings.phone | remove: ' ' }}"><span>{{ section.settings.phone }}</span><img src="{{ 'true-care-icon-phone.svg' | asset_url }}" width="16" height="16" alt=""></a>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}"><span>{{ section.settings.email }}</span><img src="{{ 'true-care-icon-email.svg' | asset_url }}" width="16" height="16" alt=""></a>
          {%- endif -%}
        </div>
      </div>

      <div class="tc-footer__column tc-footer__column--important">
        <h2>{{ section.settings.important_heading }}</h2>
        <div class="tc-footer__links">
          {%- for block in section.blocks -%}{%- if block.type == 'link' and block.settings.column == 'important' -%}<a href="{{ block.settings.url | default: routes.root_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </div>
      <div class="tc-footer__column tc-footer__column--shop">
        <h2>{{ section.settings.shop_heading }}</h2>
        <div class="tc-footer__links">
          {%- for block in section.blocks -%}{%- if block.type == 'link' and block.settings.column == 'shop' -%}<a href="{{ block.settings.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </div>
      <div class="tc-footer__column tc-footer__column--social">
        <h2>{{ section.settings.social_heading }}</h2>
        <div class="tc-footer__socials">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' -%}
              {%- assign social_icon_asset = 'true-care-icon-' | append: block.settings.icon_name | append: '.svg' -%}
              <a href="{{ block.settings.url | default: routes.root_url }}" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}><img src="{{ social_icon_asset | asset_url }}" width="18" height="18" alt=""></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
    <div class="tc-footer__bottom"><span>{{ section.settings.copyright }}</span><span>{{ section.settings.made_with }}</span></div>
  </div>
</footer>

{% schema %}
{
  "name": "True Care footer",
  "max_blocks": 16,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "منتجات عناية أنيقة ذات جودة ممتازة تناسب كل فرد من أفراد الأسرة، وبأسعار جد معقولة." },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+000 0000 0000" },
    { "type": "text", "id": "email", "label": "Email", "default": "truecare.cos@gmail.com" },
    { "type": "text", "id": "important_heading", "label": "Important links heading", "default": "الروابط مهمة" },
    { "type": "text", "id": "shop_heading", "label": "Shop heading", "default": "تسوقي" },
    { "type": "text", "id": "social_heading", "label": "Social heading", "default": "التواصل الاجتماعي" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 True Care. جميع الحقوق محفوظة" },
    { "type": "text", "id": "made_with", "label": "Footer note", "default": "صنع بعناية لعشاق الجمال الطبيعي" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fde2cb" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Footer link",
      "settings": [
        { "type": "select", "id": "column", "label": "Column", "options": [{ "value": "important", "label": "Important" }, { "value": "shop", "label": "Shop" }], "default": "important" },
        { "type": "text", "id": "label", "label": "Label", "default": "سياسة المتجر" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Instagram" },
        { "type": "select", "id": "icon_name", "label": "Icon", "options": [{ "value": "instagram", "label": "Instagram" }, { "value": "tiktok", "label": "TikTok" }, { "value": "facebook", "label": "Facebook" }, { "value": "youtube", "label": "YouTube" }], "default": "instagram" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "True Care footer",
      "blocks": [
        { "type": "link", "settings": { "column": "important", "label": "سياسة المتجر" } },
        { "type": "link", "settings": { "column": "important", "label": "معلومات عنا" } },
        { "type": "link", "settings": { "column": "important", "label": "تواصل معنا" } },
        { "type": "link", "settings": { "column": "important", "label": "سياسة الشحن" } },
        { "type": "link", "settings": { "column": "shop", "label": "العناية بالشعر" } },
        { "type": "link", "settings": { "column": "shop", "label": "العناية بالبشرة" } },
        { "type": "link", "settings": { "column": "shop", "label": "عطور" } },
        { "type": "link", "settings": { "column": "shop", "label": "جميع المنتجات" } },
        { "type": "social", "settings": { "label": "Instagram", "icon_name": "instagram" } },
        { "type": "social", "settings": { "label": "TikTok", "icon_name": "tiktok" } },
        { "type": "social", "settings": { "label": "Facebook", "icon_name": "facebook" } },
        { "type": "social", "settings": { "label": "YouTube", "icon_name": "youtube" } }
      ]
    }
  ]
}
{% endschema %}
