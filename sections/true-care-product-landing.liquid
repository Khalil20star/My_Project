{{ 'true-care-product-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign landing_product = section.settings.product | default: product
  assign selected_variant = landing_product.selected_or_first_available_variant
  assign product_form_id = 'TrueCareProductForm-' | append: section.id
  assign gallery_sizes = '(min-width: 1150px) 610px, (min-width: 768px) 50vw, 100vw'
-%}

<section
  id="TrueCare-{{ section.id }}"
  class="true-care-landing hdt-section"
  data-true-care-section
  dir="rtl"
  style="
    --tc-accent: {{ section.settings.accent_color }};
    --tc-accent-dark: {{ section.settings.accent_dark_color }};
    --tc-soft: {{ section.settings.soft_background }};
    --tc-warm: {{ section.settings.warm_background }};
    --tc-text: {{ section.settings.text_color }};
  "
>
  <div class="true-care-landing__hero true-care-landing__section">
    <div class="hdt-container true-care-landing__hero-grid">
      <div class="true-care-landing__gallery" data-product-gallery>
        <div class="true-care-landing__main-media">
          {%- if landing_product.featured_image != blank -%}
            {{
              landing_product.featured_image
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '375, 550, 750, 900, 1100, 1400',
                sizes: gallery_sizes,
                class: 'true-care-landing__main-image'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'true-care-landing__placeholder' }}
          {%- endif -%}
        </div>

        {%- if landing_product.images.size > 1 -%}
          <div class="true-care-landing__thumbnails" role="list" aria-label="{{ 'products.product.media.gallery_viewer' | t | escape }}">
            {%- for image in landing_product.images limit: 6 -%}
              <button
                type="button"
                class="true-care-landing__thumbnail{% if forloop.first %} is-active{% endif %}"
                role="listitem"
                data-gallery-thumbnail
                data-image-url="{{ image | image_url: width: 1400 }}"
                data-image-alt="{{ image.alt | default: landing_product.title | escape }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index | escape }}"
              >
                {{
                  image
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    widths: '90, 120, 180',
                    sizes: '76px',
                    alt: image.alt,
                    class: 'true-care-landing__thumbnail-image'
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="true-care-landing__product-info">
        {%- if section.settings.product_kicker != blank -%}
          <p class="true-care-landing__kicker">{{ section.settings.product_kicker }}</p>
        {%- endif -%}

        <h1 class="true-care-landing__product-title">
          {{ section.settings.product_heading | default: landing_product.title | escape }}
        </h1>

        {%- if section.settings.product_subheading != blank -%}
          <p class="true-care-landing__product-subheading">{{ section.settings.product_subheading }}</p>
        {%- endif -%}

        <div class="true-care-landing__price-row" aria-live="polite">
          {%- if selected_variant != blank -%}
            <span class="true-care-landing__price">{{ selected_variant.price | money }}</span>
            {%- if selected_variant.compare_at_price > selected_variant.price -%}
              <s class="true-care-landing__compare-price">{{ selected_variant.compare_at_price | money }}</s>
              {%- assign saving = selected_variant.compare_at_price | minus: selected_variant.price -%}
              <span class="true-care-landing__sale-badge">{{ section.settings.sale_badge_label }} {{ saving | money }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="true-care-landing__description hdt-rte">
          {%- if section.settings.product_description != blank -%}
            {{ section.settings.product_description }}
          {%- elsif landing_product.description != blank -%}
            {{ landing_product.description | strip_html | truncatewords: 35 }}
          {%- endif -%}
        </div>

        <ul class="true-care-landing__product-points" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_point' -%}
              <li {{ block.shopify_attributes }}>
                <span class="true-care-landing__check" aria-hidden="true">✓</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if landing_product != blank -%}
          {%- form 'product', landing_product, id: product_form_id, class: 'true-care-landing__product-form' -%}
            {%- unless landing_product.has_only_default_variant -%}
              <label class="true-care-landing__variant-label" for="TrueCareVariant-{{ section.id }}">
                {{ 'products.product.choose_options' | t | default: 'اختاري النوع' }}
              </label>
              <select id="TrueCareVariant-{{ section.id }}" name="id" class="true-care-landing__variant-select">
                {%- for variant in landing_product.variants -%}
                  <option value="{{ variant.id }}"{% if variant == selected_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            {%- else -%}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
            {%- endunless -%}

            <div class="true-care-landing__buy-row">
              <div class="true-care-landing__quantity" data-quantity-selector>
                <button type="button" data-quantity-action="increase" aria-label="{{ 'products.product.quantity.increase' | t: product: landing_product.title | escape }}">+</button>
                <input
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  aria-label="{{ 'products.product.quantity.input_label' | t: product: landing_product.title | escape }}"
                >
                <button type="button" data-quantity-action="decrease" aria-label="{{ 'products.product.quantity.decrease' | t: product: landing_product.title | escape }}">−</button>
              </div>
              <button
                type="submit"
                name="add"
                class="true-care-landing__add-button hdt-btn hdt-btn-solid hdt-font-semibold"
                {% unless selected_variant.available %}disabled{% endunless %}
              >
                {%- if selected_variant.available -%}
                  {{ section.settings.add_to_cart_label }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>
          {%- endform -%}
        {%- endif -%}

        <div class="true-care-landing__bundles">
          {%- if section.settings.bundle_heading != blank -%}
            <p class="true-care-landing__bundles-heading">{{ section.settings.bundle_heading }}</p>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'bundle_product' -%}
              {%- assign bundle_product = block.settings.product -%}
              <article class="true-care-landing__bundle" {{ block.shopify_attributes }}>
                <div class="true-care-landing__bundle-media">
                  {%- if bundle_product.featured_image != blank -%}
                    {{ bundle_product.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 140, 180', sizes: '64px' }}
                  {%- else -%}
                    {{ 'product-2' | placeholder_svg_tag: 'true-care-landing__placeholder' }}
                  {%- endif -%}
                </div>
                <div class="true-care-landing__bundle-copy">
                  <h3>{{ block.settings.heading | default: bundle_product.title }}</h3>
                  {%- if bundle_product != blank -%}<p>{{ bundle_product.price | money }}</p>{%- endif -%}
                </div>
                {%- if bundle_product.available -%}
                  {%- form 'product', bundle_product, class: 'true-care-landing__bundle-form' -%}
                    <input type="hidden" name="id" value="{{ bundle_product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="true-care-landing__bundle-button">{{ block.settings.button_label }}</button>
                  {%- endform -%}
                {%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="true-care-landing__comparison true-care-landing__section">
    <div class="hdt-container">
      <header class="true-care-landing__section-heading">
        <p>{{ section.settings.comparison_kicker }}</p>
        <h2>{{ section.settings.comparison_heading }}</h2>
        <div>{{ section.settings.comparison_subheading }}</div>
      </header>

      <div class="true-care-landing__comparison-grid">
        <article class="true-care-landing__comparison-card true-care-landing__comparison-card--before">
          <span class="true-care-landing__comparison-status true-care-landing__comparison-status--before" aria-hidden="true">×</span>
          <h3>{{ section.settings.before_heading }}</h3>
          <div class="hdt-rte">{{ section.settings.before_content | newline_to_br }}</div>
        </article>

        <div class="true-care-landing__comparison-media" data-comparison>
          {%- if section.settings.before_image != blank -%}
            {{ section.settings.before_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900', sizes: '(min-width: 768px) 360px, calc(100vw - 30px)', class: 'true-care-landing__comparison-image' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'true-care-landing__comparison-image true-care-landing__placeholder' }}
          {%- endif -%}
          <div class="true-care-landing__comparison-after" aria-hidden="true">
            {%- if section.settings.after_image != blank -%}
              {{ section.settings.after_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900', sizes: '(min-width: 768px) 360px, calc(100vw - 30px)', class: 'true-care-landing__comparison-image' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'true-care-landing__comparison-image true-care-landing__placeholder' }}
            {%- endif -%}
          </div>
          <span class="true-care-landing__comparison-line" aria-hidden="true"></span>
          <span class="true-care-landing__comparison-handle" aria-hidden="true">↔</span>
          <label class="hdt-hidden" for="TrueCareComparison-{{ section.id }}">{{ section.settings.comparison_control_label }}</label>
          <input
            id="TrueCareComparison-{{ section.id }}"
            class="true-care-landing__comparison-range"
            type="range"
            min="0"
            max="100"
            value="50"
            data-comparison-range
          >
        </div>

        <article class="true-care-landing__comparison-card true-care-landing__comparison-card--after">
          <span class="true-care-landing__comparison-status true-care-landing__comparison-status--after" aria-hidden="true">✓</span>
          <h3>{{ section.settings.after_heading }}</h3>
          <div class="hdt-rte">{{ section.settings.after_content | newline_to_br }}</div>
        </article>
      </div>
    </div>
  </div>

  <div class="true-care-landing__usage true-care-landing__section">
    <div class="hdt-container">
      <header class="true-care-landing__section-heading">
        <p>{{ section.settings.usage_kicker }}</p>
        <h2>{{ section.settings.usage_heading }}</h2>
        <div>{{ section.settings.usage_subheading }}</div>
      </header>
      {%- assign usage_steps = section.blocks | where: 'type', 'usage_step' -%}
      <ol class="true-care-landing__steps">
        {%- for block in usage_steps -%}
          <li class="true-care-landing__step" {{ block.shopify_attributes }}>
            <span class="true-care-landing__step-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>

  <div class="true-care-landing__benefits true-care-landing__section">
    <div class="hdt-container">
      <header class="true-care-landing__section-heading">
        <p>{{ section.settings.benefits_kicker }}</p>
        <h2>{{ section.settings.benefits_heading }}</h2>
        <div>{{ section.settings.benefits_subheading }}</div>
      </header>
      <div class="true-care-landing__benefits-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <article class="true-care-landing__benefit" {{ block.shopify_attributes }}>
              <span class="true-care-landing__benefit-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              <div>
                <h3>{{ block.settings.heading }}</h3>
                <p>{{ block.settings.text }}</p>
                {%- if block.settings.note != blank -%}<small>{{ block.settings.note }}</small>{%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="true-care-landing__reviews true-care-landing__section">
    <div class="hdt-container">
      <header class="true-care-landing__section-heading">
        <p>{{ section.settings.reviews_kicker }}</p>
        <h2>{{ section.settings.reviews_heading }}</h2>
        <div>{{ section.settings.reviews_subheading }}</div>
      </header>

      <div class="true-care-landing__review-summary">
        <div class="true-care-landing__review-score">
          <div class="true-care-landing__stars" aria-label="{{ section.settings.rating }} من 5">★★★★★</div>
          <strong>{{ section.settings.rating }}</strong>
          <span>{{ section.settings.review_count_label }}</span>
        </div>
        <div class="true-care-landing__rating-bars" aria-hidden="true">
          {%- for rating_number in (1..5) reversed -%}
            {%- assign bar_width = rating_number | times: 18 -%}
            <div><span>{{ rating_number }}</span><i><b style="width: {{ bar_width }}%"></b></i><em>★★★★★</em></div>
          {%- endfor -%}
        </div>
        {%- if section.settings.review_link != blank -%}
          <a class="true-care-landing__review-cta" href="{{ section.settings.review_link }}">{{ section.settings.review_button_label }}</a>
        {%- else -%}
          <span class="true-care-landing__review-cta" role="link" aria-disabled="true">{{ section.settings.review_button_label }}</span>
        {%- endif -%}
      </div>

      <div class="true-care-landing__review-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <article class="true-care-landing__review" {{ block.shopify_attributes }}>
              <div class="true-care-landing__stars" aria-label="5 من 5">★★★★★</div>
              <h3>{{ block.settings.author }}</h3>
              {%- if block.settings.verified_label != blank -%}<span class="true-care-landing__verified">✓ {{ block.settings.verified_label }}</span>{%- endif -%}
              <p>{{ block.settings.text }}</p>
              {%- if block.settings.date != blank -%}<time>{{ block.settings.date }}</time>{%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="true-care-landing__faq true-care-landing__section">
    <div class="hdt-container true-care-landing__narrow">
      <header class="true-care-landing__section-heading">
        <p>{{ section.settings.faq_kicker }}</p>
        <h2>{{ section.settings.faq_heading }}</h2>
        <div>{{ section.settings.faq_subheading }}</div>
      </header>
      <div class="true-care-landing__faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="true-care-landing__faq-item" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <span class="true-care-landing__faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="true-care-landing__faq-answer hdt-rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="true-care-landing__products true-care-landing__section">
    <div class="hdt-container">
      <header class="true-care-landing__section-heading">
        <p>{{ section.settings.products_kicker }}</p>
        <h2>{{ section.settings.products_heading }}</h2>
        <div>{{ section.settings.products_subheading }}</div>
      </header>
      <div class="true-care-landing__product-grid">
        {%- if section.settings.complementary_products != blank -%}
          {%- for card_product in section.settings.complementary_products limit: 4 -%}
            <article class="true-care-landing__product-card">
              <a href="{{ card_product.url }}" class="true-care-landing__product-card-media">
                {%- if card_product.featured_image != blank -%}
                  {{ card_product.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', widths: '180, 300, 450, 650', sizes: '(min-width: 768px) 25vw, 44vw' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'true-care-landing__placeholder' }}
                {%- endif -%}
              </a>
              <div class="true-care-landing__product-card-copy">
                <h3><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
                <p>{{ card_product.price | money }}</p>
                {%- if card_product.available -%}
                  {%- form 'product', card_product -%}
                    <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit">{{ section.settings.product_card_button_label }}</button>
                  {%- endform -%}
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for index in (1..4) -%}
            <article class="true-care-landing__product-card">
              <div class="true-care-landing__product-card-media">{{ 'product-' | append: index | placeholder_svg_tag: 'true-care-landing__placeholder' }}</div>
              <div class="true-care-landing__product-card-copy"><h3>{{ section.settings.placeholder_product_title }}</h3><p>{{ 1400 | money }}</p><button type="button" disabled>{{ section.settings.product_card_button_label }}</button></div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="true-care-landing__videos true-care-landing__section">
    <div class="hdt-container">
      <header class="true-care-landing__section-heading">
        <h2>{{ section.settings.videos_heading }}</h2>
        <div>{{ section.settings.videos_subheading }}</div>
      </header>
      <div class="true-care-landing__video-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video_card' -%}
            <article class="true-care-landing__video-card" {{ block.shopify_attributes }}>
              {%- if block.settings.video_url != blank -%}<a href="{{ block.settings.video_url }}" aria-label="{{ block.settings.heading | escape }}">{%- endif -%}
                <div class="true-care-landing__video-media">
                  {%- if block.settings.cover_image != blank -%}
                    {{ block.settings.cover_image | image_url: width: 650 | image_tag: loading: 'lazy', widths: '180, 300, 450, 650', sizes: '(min-width: 768px) 17vw, 44vw' }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'true-care-landing__placeholder' }}
                  {%- endif -%}
                  <span class="true-care-landing__play" aria-hidden="true">▶</span>
                </div>
                <div class="true-care-landing__video-copy">
                  <h3>{{ block.settings.heading }}</h3>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- if block.settings.video_url != blank -%}</a>{%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const initTrueCareSection = (root) => {
      if (!root || root.dataset.trueCareReady === 'true') return;
      root.dataset.trueCareReady = 'true';

      const comparison = root.querySelector('[data-comparison]');
      const comparisonRange = root.querySelector('[data-comparison-range]');
      if (comparison && comparisonRange) {
        const updateComparison = () => comparison.style.setProperty('--comparison-position', `${comparisonRange.value}%`);
        comparisonRange.addEventListener('input', updateComparison);
        updateComparison();
      }

      const mainImage = root.querySelector('.true-care-landing__main-image');
      root.querySelectorAll('[data-gallery-thumbnail]').forEach((thumbnail) => {
        thumbnail.addEventListener('click', () => {
          if (!mainImage) return;
          mainImage.src = thumbnail.dataset.imageUrl;
          mainImage.alt = thumbnail.dataset.imageAlt || '';
          mainImage.removeAttribute('srcset');
          mainImage.removeAttribute('sizes');
          root.querySelectorAll('[data-gallery-thumbnail]').forEach((item) => {
            const isCurrent = item === thumbnail;
            item.classList.toggle('is-active', isCurrent);
            item.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
          });
        });
      });

      root.querySelectorAll('[data-quantity-selector]').forEach((selector) => {
        const input = selector.querySelector('input[type="number"]');
        if (!input) return;
        selector.querySelectorAll('[data-quantity-action]').forEach((button) => {
          button.addEventListener('click', () => {
            const current = Number.parseInt(input.value, 10) || 1;
            input.value = button.dataset.quantityAction === 'increase' ? current + 1 : Math.max(1, current - 1);
            input.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
      });
    };

    document.querySelectorAll('[data-true-care-section]').forEach(initTrueCareSection);
    document.addEventListener('shopify:section:load', (event) => {
      initTrueCareSection(event.target.querySelector('[data-true-care-section]'));
    });
  })();
</script>

{% schema %}
{
  "name": "True Care product landing",
  "tag": "section",
  "class": "hdt-section true-care-product-landing-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 50,
  "settings": [
    { "type": "header", "content": "Product hero" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "product_kicker", "label": "Product kicker", "default": "ترو كير • عناية يومية" },
    { "type": "text", "id": "product_heading", "label": "Product heading", "default": "شامبو لتنقية فروة الرأس" },
    { "type": "text", "id": "product_subheading", "label": "Product subheading", "default": "300 مل" },
    { "type": "richtext", "id": "product_description", "label": "Product description", "default": "<p>تركيبة متوازنة تنظف فروة الرأس بلطف وتساعد على إزالة التراكمات والشوائب دون أن تفقد الشعر ترطيبه الطبيعي.</p>" },
    { "type": "text", "id": "sale_badge_label", "label": "Sale badge label", "default": "وفري" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "أضف إلى السلة" },
    { "type": "text", "id": "bundle_heading", "label": "Bundle heading", "default": "خذي روتيناً متكاملاً" },

    { "type": "header", "content": "Before and after" },
    { "type": "text", "id": "comparison_kicker", "label": "Kicker", "default": "تغيير يبان من أول مرة" },
    { "type": "text", "id": "comparison_heading", "label": "Heading", "default": "من أول استخدام بتلاحظين الفرق" },
