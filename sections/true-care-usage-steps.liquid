{{ 'true-care-product-sections.css' | asset_url | stylesheet_tag }}

<section id="TrueCareUsage-{{ section.id }}" class="tc-section tc-usage tc-section__body" dir="rtl" style="--tc-padding-top: {{ section.settings.padding_top }}px; --tc-padding-bottom: {{ section.settings.padding_bottom }}px; --tc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --tc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --tc-accent: {{ section.settings.accent_color }};">
  <div class="tc-container">
    <header class="tc-heading">
      <p class="tc-heading__kicker">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="tc-heading__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>
    <ol class="tc-steps">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' and block.settings.heading != blank -%}
          <li class="tc-step" {{ block.shopify_attributes }}>
            <span class="tc-step__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "True Care usage steps",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "خطوة بخطوة" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "طريقة الاستخدام" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "5 خطوات بسيطة — نتيجة تلاحظينها من أول غسيل" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff997f" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 100, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 100, "step": 4, "default": 52 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 20, "max": 80, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 20, "max": 80, "step": 4, "default": 40 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "بللي الشعر" }, { "type": "text", "id": "text", "label": "Description", "default": "بالماء جيداً قبل الشامبو" }] }
  ],
  "presets": [
    {
      "name": "True Care usage steps",
      "blocks": [
        { "type": "step", "settings": { "heading": "بللي الشعر", "text": "بالماء جيداً قبل الشامبو" } },
        { "type": "step", "settings": { "heading": "ضعي الشامبو", "text": "كمية مناسبة على الفروة" } },
        { "type": "step", "settings": { "heading": "دلكي برفق", "text": "حتى يتكوّن رغوة جيداً" } },
        { "type": "step", "settings": { "heading": "اشطفي جيداً", "text": "بالماء حتى النظافة التامة" } },
        { "type": "step", "settings": { "heading": "كرري 2–3 مرات", "text": "أسبوعياً أو حسب الحاجة" } }
      ]
    }
  ]
}
{% endschema %}
