{{ 'true-care-product-sections.css' | asset_url | stylesheet_tag }}

<section id="TrueCareFaq-{{ section.id }}" class="tc-section tc-faq tc-section__body" dir="rtl" style="--tc-cream: {{ section.settings.background_color }}; --tc-accent: {{ section.settings.accent_color }}; --tc-padding-top: {{ section.settings.padding_top }}px; --tc-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="tc-container">
    <header class="tc-heading">
      <p class="tc-heading__kicker">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="tc-heading__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>
    <div class="tc-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' and block.settings.question != blank -%}
          <details class="tc-faq__item" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
            <summary><span>{{ block.settings.question }}</span><span class="tc-faq__icon" aria-hidden="true"></span></summary>
            <div class="tc-faq__answer hdt-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "True Care FAQ",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "أسئلة شائعة" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "عندك سؤال؟" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "إجابات على أكثر الأسئلة اللي تسألينها عن الشامبو" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fff7f1" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff997f" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 100, "step": 4, "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 24, "max": 100, "step": 4, "default": 52 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "هل الشامبو مناسب للاستخدام اليومي؟" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>يمكن استخدامه حسب حاجة فروة الرأس، ويُفضّل اعتماد روتين مناسب لطبيعة الشعر.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "True Care FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "هل الشامبو مناسب للاستخدام اليومي؟" } },
        { "type": "faq", "settings": { "question": "هل هو مناسب لفروة الرأس الحساسة؟" } },
        { "type": "faq", "settings": { "question": "متى تبدأ ظهور النتائج؟" } },
        { "type": "faq", "settings": { "question": "هل يصلح للشعر المصبوغ؟" } },
        { "type": "faq", "settings": { "question": "هل يساعد على تقليل التساقط؟" } },
        { "type": "faq", "settings": { "question": "هل يُشحن لخارج الكويت؟" } }
      ]
    }
  ]
}
{% endschema %}
