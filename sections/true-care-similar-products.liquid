{{ 'true-care-product-sections.css' | asset_url | stylesheet_tag }}

<section
  id="TrueCareSimilar-{{ section.id }}"
  class="tc-section tc-similar tc-section__body"
  dir="rtl"
  data-tc-similar
  style="--tc-similar-bg: {{ section.settings.background_color }}; --tc-similar-accent: {{ section.settings.accent_color }}; --tc-similar-price: {{ section.settings.price_color }}; --tc-padding-top: {{ section.settings.padding_top }}px; --tc-padding-bottom: {{ section.settings.padding_bottom }}px; --tc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --tc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;"
>
  <div class="tc-container">
    <header class="tc-heading tc-similar__heading">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="tc-heading__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>

    <div class="tc-similar__grid" data-tc-similar-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_product = block.settings.product
          assign card_variant = card_product.selected_or_first_available_variant
          assign fallback_asset = 'true-care-routine-brush.jpg'
          case block.settings.fallback_image
            when 'moisturizer'
              assign fallback_asset = 'true-care-routine-moisturizer.jpg'
            when 'scrub'
              assign fallback_asset = 'true-care-routine-scrub.jpg'
            when 'box'
              assign fallback_asset = 'true-care-routine-box.jpg'
          endcase

          if card_product != blank
            assign card_title = card_product.title
            assign card_url = card_product.url
            assign current_price_display = card_variant.price | money | replace: '.000', '.00' | replace: ',000', ',00'
            assign compare_price_display = card_variant.compare_at_price | money | replace: '.000', '.00' | replace: ',000', ',00'
          else
            assign card_title = block.settings.heading
            assign card_url = block.settings.url | default: routes.all_products_collection_url
            assign current_price_display = block.settings.price
            assign compare_price_display = block.settings.compare_price
          endif
        -%}

        <article class="tc-similar__card" data-tc-similar-card {{ block.shopify_attributes }}>
          <a class="tc-similar__media" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
            {%- if card_product.featured_image != blank -%}
              {{ card_product.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600, 760', sizes: '(min-width: 768px) 255px, 46vw', alt: card_product.featured_image.alt }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600, 760', sizes: '(min-width: 768px) 255px, 46vw', alt: card_title }}
            {%- else -%}
              <img src="{{ fallback_asset | asset_url }}" width="759" height="738" loading="lazy" alt="{{ card_title | escape }}">
            {%- endif -%}

            {%- if card_product != blank and card_variant.compare_at_price > card_variant.price -%}
              {%- assign discount_percent = card_variant.compare_at_price | minus: card_variant.price | times: 100 | divided_by: card_variant.compare_at_price -%}
              <span class="tc-similar__discount">{{ section.settings.discount_prefix }} {{ discount_percent }}%</span>
            {%- elsif block.settings.discount_label != blank -%}
              <span class="tc-similar__discount">{{ block.settings.discount_label }}</span>
            {%- endif -%}
          </a>

          <div class="tc-similar__copy">
            <h3><a href="{{ card_url }}">{{ card_title }}</a></h3>
            <div class="tc-similar__prices">
              <span class="tc-similar__price">{{ current_price_display }}</span>
              {%- if card_product != blank and card_variant.compare_at_price > card_variant.price -%}
                <s class="tc-similar__compare">{{ compare_price_display }}</s>
              {%- elsif card_product == blank and compare_price_display != blank -%}
                <s class="tc-similar__compare">{{ compare_price_display }}</s>
              {%- endif -%}
            </div>

            {%- if card_product != blank and card_product.available -%}
              {%- form 'product', card_product, class: 'tc-similar__form' -%}
                <input type="hidden" name="id" value="{{ card_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button class="tc-similar__button" type="submit">{{ section.settings.button_label }}</button>
              {%- endform -%}
            {%- elsif card_product != blank -%}
              <button class="tc-similar__button" type="button" disabled>{{ 'products.product.sold_out' | t }}</button>
            {%- else -%}
              <a class="tc-similar__button" href="{{ card_url }}">{{ section.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="tc-similar__pagination" aria-label="{{ section.settings.pagination_label | escape }}">
        {%- for block in section.blocks -%}
          <button type="button" class="tc-similar__dot{% if forloop.first %} is-active{% endif %}" data-tc-similar-dot="{{ forloop.index0 }}" aria-label="{{ section.settings.slide_label | escape }} {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('TrueCareSimilar-{{ section.id }}');
    if (!root || root.dataset.similarReady === 'true') return;

    const track = root.querySelector('[data-tc-similar-track]');
    const cards = [...root.querySelectorAll('[data-tc-similar-card]')];
    const dots = [...root.querySelectorAll('[data-tc-similar-dot]')];
    if (!track || cards.length < 2 || dots.length === 0) return;

    root.dataset.similarReady = 'true';
    let frame;
    const setActiveDot = () => {
      frame = undefined;
      const trackBox = track.getBoundingClientRect();
      const center = trackBox.left + (trackBox.width / 2);
      let activeIndex = 0;
      let nearest = Infinity;

      cards.forEach((card, index) => {
        const box = card.getBoundingClientRect();
        const distance = Math.abs((box.left + (box.width / 2)) - center);
        if (distance < nearest) {
          nearest = distance;
          activeIndex = index;
        }
      });

      dots.forEach((dot, index) => {
        const active = index === activeIndex;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    track.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(setActiveDot);
    }, { passive: true });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => cards[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' }));
    });

    setActiveDot();
  })();
</script>

{% schema %}
{
  "name": "True Care similar products",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "منتجات مشابهة" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "discount_prefix", "label": "Automatic discount prefix", "default": "خصم" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "أضف الى السلة" },
    { "type": "text", "id": "pagination_label", "label": "Pagination accessibility label", "default": "التنقل بين المنتجات المشابهة" },
    { "type": "text", "id": "slide_label", "label": "Slide accessibility label", "default": "المنتج" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fdfdfd" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#f59f87" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#ff3b30" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 24, "max": 100, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 24, "max": 100, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 16, "max": 80, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 16, "max": 80, "step": 4, "default": 40 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify product" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "select", "id": "fallback_image", "label": "Design fallback image", "options": [{ "value": "brush", "label": "Hair brush" }, { "value": "moisturizer", "label": "Hair moisturizer" }, { "value": "scrub", "label": "Scalp scrub" }, { "value": "box", "label": "Care box" }], "default": "brush" },
        { "type": "text", "id": "heading", "label": "Fallback title", "default": "فرشاة فك تشابك الشعر" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "14.00 KD" },
        { "type": "text", "id": "compare_price", "label": "Fallback compare price", "default": "19.00 KD" },
        { "type": "text", "id": "discount_label", "label": "Fallback discount", "default": "خصم 30%" },
        { "type": "url", "id": "url", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "منتجات مشابهة",
      "blocks": [
        { "type": "product", "settings": { "fallback_image": "brush", "heading": "فرشاة فك تشابك الشعر" } },
        { "type": "product", "settings": { "fallback_image": "moisturizer", "heading": "مرطب للشعر بزبدة الشيا" } },
        { "type": "product", "settings": { "fallback_image": "scrub", "heading": "سنفرة تنظيف فروة الرأس" } },
        { "type": "product", "settings": { "fallback_image": "box", "heading": "بوكس العناية بفروة الشعر" } }
      ]
    }
  ]
}
{% endschema %}
