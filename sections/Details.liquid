        },
        {
          "type":"textarea",
          "id":"text",
          "label":"Description",
          "default":"بالماء جيدًا قبل الشامبو"
        }
      ]
    }
  ],

  "presets": [
    {
      "name":"Usage Steps",
      "blocks":[
        {
          "type":"step",
          "settings":{
            "number":"05",
            "title":"كرري 2-3 مرات",
            "text":"أسبوعيًا أو حسب الحاجة"
          }
        },
        {
          "type":"step",
          "settings":{
            "number":"04",
            "title":"اشطفي جيدًا",
            "text":"بالماء حتى النظافة التامة"
          }
        },
        {
          "type":"step",
          "settings":{
            "number":"03",
            "title":"دلكي بلطف",
            "text":"حتى يتكون رغوة جيدًا"
          }
        },
        {
          "type":"step",
          "settings":{
            "number":"02",
            "title":"ضعي الشامبو",
            "text":"كمية مناسبة على الفروة"
          }
        },
        {
          "type":"step",
          "settings":{
            "number":"01",
            "title":"بللي الشعر",
            "text":"بالماء جيدًا قبل الشامبو"
          }
        }
      ]
    }
  ]
}
{% endschema %}