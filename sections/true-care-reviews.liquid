{{ 'true-care-product-sections.css' | asset_url | stylesheet_tag }}

<section id="TrueCareReviews-{{ section.id }}" class="tc-section tc-reviews tc-section__body" dir="rtl" style="--tc-accent: {{ section.settings.accent_color }}; --tc-green: {{ section.settings.green_color }}; --tc-padding-top: {{ section.settings.padding_top }}px; --tc-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="tc-container">
    <header class="tc-heading">
      <div class="tc-stars" aria-hidden="true">★★★★★</div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="tc-heading__sub">{{ section.settings.subheading }}</p>
    </header>

    <div class="tc-reviews__summary">
      <div class="tc-reviews__score">
        <div><strong>{{ section.settings.rating }}</strong><span class="tc-stars" aria-label="{{ section.settings.rating }} من 5">★★★★☆</span><span>من 5</span></div>
        <p>✓ {{ section.settings.review_count_label }}</p>
      </div>
      <div class="tc-reviews__bars">
        {%- for score in (1..5) reversed -%}
          {%- case score -%}
            {%- when 5 -%}{%- assign amount = section.settings.distribution_5 -%}
            {%- when 4 -%}{%- assign amount = section.settings.distribution_4 -%}
            {%- when 3 -%}{%- assign amount = section.settings.distribution_3 -%}
            {%- when 2 -%}{%- assign amount = section.settings.distribution_2 -%}
            {%- else -%}{%- assign amount = section.settings.distribution_1 -%}
          {%- endcase -%}
          <div class="tc-reviews__bar"><span>{{ amount }}</span><span class="tc-reviews__track"><span class="tc-reviews__fill" style="--bar-width: {{ amount | times: 10 }}%;"></span></span><span class="tc-stars" aria-hidden="true">★★★★★</span></div>
        {%- endfor -%}
      </div>
      {%- if section.settings.review_link != blank -%}<a class="tc-reviews__write" href="{{ section.settings.review_link }}">{{ section.settings.review_button_label }}</a>{%- else -%}<span class="tc-reviews__write" aria-disabled="true">{{ section.settings.review_button_label }}</span>{%- endif -%}
    </div>

    <div class="tc-reviews__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="tc-review" {{ block.shopify_attributes }}>
            <div class="tc-stars" role="img" aria-label="{{ block.settings.rating }} من 5">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
            {%- if block.settings.date != blank -%}<time datetime="{{ block.settings.date | escape }}">{{ block.settings.date }}</time>{%- endif -%}
            <div class="tc-review__top"><h3>{{ block.settings.author }}</h3>{%- if block.settings.verified_label != blank -%}<span class="tc-review__verified">● {{ block.settings.verified_label }}</span>{%- endif -%}</div>
            {%- if block.settings.title != blank -%}<h4>{{ block.settings.title }}</h4>{%- endif -%}
            <p>{{ block.settings.text }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="tc-reviews__pagination" aria-hidden="true">» » 2 1</div>
  </div>
</section>

{% schema %}
{
  "name": "True Care reviews",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "عملاؤنا يتحدثون عن تجربتهم" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "تجربتك معنا يجب أن تكون استثنائية من البداية للنهاية" },
    { "type": "text", "id": "rating", "label": "Average rating", "default": "4.30" },
    { "type": "text", "id": "review_count_label", "label": "Review count", "default": "بناءً على 10 مراجعات" },
    { "type": "range", "id": "distribution_5", "label": "5-star reviews", "min": 0, "max": 10, "step": 1, "default": 7 },
    { "type": "range", "id": "distribution_4", "label": "4-star reviews", "min": 0, "max": 10, "step": 1, "default": 1 },
    { "type": "range", "id": "distribution_3", "label": "3-star reviews", "min": 0, "max": 10, "step": 1, "default": 1 },
    { "type": "range", "id": "distribution_2", "label": "2-star reviews", "min": 0, "max": 10, "step": 1, "default": 0 },
    { "type": "range", "id": "distribution_1", "label": "1-star reviews", "min": 0, "max": 10, "step": 1, "default": 1 },
    { "type": "text", "id": "review_button_label", "label": "Button label", "default": "كتابة مراجعة" },
    { "type": "url", "id": "review_link", "label": "Button link" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff997f" },
    { "type": "color", "id": "green_color", "label": "Rating bar", "default": "#2f7f65" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 100, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 24, "max": 100, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "author", "label": "Author", "default": "جنان الملا" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "verified_label", "label": "Verified label", "default": "موثق" },
        { "type": "text", "id": "title", "label": "Title", "default": "أحب شكل الزجاجة" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "أحببت شكل الزجاجة والرائحة، أحلى عطر جربته في حياتي." },
        { "type": "text", "id": "date", "label": "Date", "default": "03/20/2026" }
      ]
    }
  ],
  "presets": [
    {
      "name": "True Care reviews",
      "blocks": [
        { "type": "review", "settings": { "author": "جنان الملا", "title": "أحب شكل الزجاجة", "text": "أحببت شكل الزجاجة والرائحة، أحلى عطر جربته في حياتي." } },
        { "type": "review", "settings": { "author": "فهد القحطاني", "title": "يستحق كل فلس.", "text": "كنت متردد لما شريته، لكن بعد ما جربته حسيت أنه يستحق كل فلس." } },
        { "type": "review", "settings": { "author": "راشد السعيد", "title": "ريحتها مميزة وفخمة", "text": "ريحتها مميزة وفخمة، كل اللي يجربها يقول لي عنها، وأكيد أحبها." } }
      ]
    }
  ]
}
{% endschema %}
