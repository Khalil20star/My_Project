{{ 'hdt-main-pages.css' | asset_url | stylesheet_tag }}
{{ 'facets.css' | asset_url | stylesheet_tag }}
{{ 'hdt-pagination.css' | asset_url | stylesheet_tag }}
{{ 'true-care-product-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products_id = 'products-' | append: section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .tc-collection {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .tc-collection__description {
    margin-block-end: 3rem;
    text-align: start;
  }

  #shopify-section-{{ section.id }} .tc-collection__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    margin-block-end: 2.4rem;
  }

  #shopify-section-{{ section.id }} .tc-collection__grid {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
  }

  #shopify-section-{{ section.id }} .tc-routine__card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .tc-routine__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .tc-routine__copy form {
    margin-block-start: auto;
  }

  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .tc-collection__grid {
      gap: 24px;
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .tc-collection {
      padding-block: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .tc-collection__grid {
      gap: 10px;
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<section class="tc-collection" dir="rtl" style="--tc-accent: {{ section.settings.accent_color }}; --tc-accent-strong: {{ section.settings.price_color }};">
  <div class="hdt-container">
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="tc-collection__description hdt-rte">{{ collection.description }}</div>
    {%- endif -%}

    {%- if collection.all_products_count > 0 -%}
      <div class="tc-collection__controls">
        <div>
          {%- if section.settings.enable_filtering -%}
            <button class="hdt-filter_btn hdt-inline-flex hdt-align-center" aria-controls="hdt-filter_form">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M4 7h16M7 12h10M10 17h4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"/></svg>
              <span>{{ 'products.facets.filter_button' | t }}</span>
            </button>
            {%- render 'facets', results: collection, section_id: section.id, enable_render_on_change: true -%}
          {%- endif -%}
        </div>

        <div>
          {%- if section.settings.enable_sorting -%}
            {%- render 'sort-by-popover', results: collection, section_id: section.id -%}
          {%- endif -%}
        </div>
      </div>
      {%- render 'active-filters', results: collection, results_count: collection.products_count -%}
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div id="{{ products_id }}" class="tc-collection__grid">
          {%- for card_product in collection.products -%}
            {%- assign card_variant = card_product.selected_or_first_available_variant -%}
            <article class="tc-routine__card">
              {%- if card_variant.compare_at_price > card_variant.price -%}
                <span class="tc-routine__discount">{{ section.settings.discount_label }}</span>
              {%- endif -%}
              <a class="tc-routine__media" href="{{ card_product.url | within: collection }}">
                {%- if card_product.featured_image != blank -%}
                  {{ card_product.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600, 760', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', alt: card_product.featured_image.alt, class: 'tc-routine__image tc-routine__image--primary' }}
                  {%- if card_product.images[1] != blank -%}
                    {{ card_product.images[1] | image_url: width: 760 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600, 760', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', alt: card_product.images[1].alt, class: 'tc-routine__image tc-routine__image--secondary' }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
              <div class="tc-routine__copy">
                <h3><a href="{{ card_product.url | within: collection }}">{{ card_product.title }}</a></h3>
                <div class="tc-routine__prices">
                  <span class="tc-routine__price">{{ card_variant.price | money }}</span>
                  {%- if card_variant.compare_at_price > card_variant.price -%}
                    <s class="tc-routine__compare">{{ card_variant.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>
                {%- if card_product.available -%}
                  {%- form 'product', card_product -%}
                    <input type="hidden" name="id" value="{{ card_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button class="tc-routine__button" type="submit">{{ section.settings.button_label }}</button>
                  {%- endform -%}
                {%- else -%}
                  <button class="tc-routine__button" type="button" disabled>{{ 'products.product.sold_out' | t }}</button>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate, anchor: '', section_id: section.id, pagination_type: 'links', append_id: products_id, paginate_pos: 'center', dis_pagination: 40, lm_text: '' -%}
      {%- else -%}
        <div class="hdt-template hdt-template--empty hdt-text-center">
          <p class="hdt-h5 hdt-s-text">{{ 'sections.collection_template.empty' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "True Care collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 12
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount label",
      "default": "خصم 30%"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "أضف إلى السلة"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button and discount color",
      "default": "#ff997f"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#f44336"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "True Care collection"
    }
  ]
}
{% endschema %}
